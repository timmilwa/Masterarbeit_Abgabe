{
  "name": "kaleido-overlay",
  "productName": "Kaleido",
  "version": "1.0.0",
  "description": "Electron Overlay Canvas App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chokidar": "^3.5.3",
    "lucide": "^0.562.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.kaleido.overlay",
    "productName": "Kaleido",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "entitlements": "entitlements.mac.plist",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Kaleido needs accessibility permissions to monitor keyboard shortcuts for toggling screenshot mode.",
        "NSHighResolutionCapable": true
      }
    },
    "files": [
      "**/*",
      "!config/**",
      "assets/**/*",
      "main.js",
      "index.html",
      "renderer.js",
      "key_listener",
      "selection_listener",
      "get_windows"
    ]
  }
}
